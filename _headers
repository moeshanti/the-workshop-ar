# 1. Service Worker MUST never be cached
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# 2. Web App Manifest
/manifest.json
  Cache-Control: no-cache, no-store, must-revalidate

# 3. HTML Navigation Shells (Both root and explicit index.html)
/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/
  Cache-Control: no-cache, no-store, must-revalidate
